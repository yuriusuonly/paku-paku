{
  "name": "paku-paku",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": {
    "bun": ">=1.4.5"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "bun": "bun ./scripts/bun.js",
    "bun:test": "bun ./scripts/bun.js test",
    "caddy": "bun ./scripts/caddy.js run --config Caddyfile",
    "caddy:trust": "bun ./scripts/caddy.js trust",
    "docker": "bun run docker:build && bun run docker:up && bun run docker:logs",
    "docker:build": "bun ./scripts/docker.js compose --profile app build --no-cache",
    "docker:down": "bun ./scripts/docker.js compose --profile app --profile build --profile test down --remove-orphans",
    "docker:logs": "bun ./scripts/docker.js compose --profile app logs -f",
    "docker:up": "bun ./scripts/docker.js compose --profile app up -d",
    "eas:deploy": "bun run expo:build && bun ./scripts/eas.js deploy --non-interactive --prod --environment production --export-dir build",
    "eas:initialize": "bun ./scripts/eas.js init",
    "expo:build": "bun ./scripts/expo.js export --platform web --output-dir build",
    "expo:serve": "bun ./scripts/expo.js serve build",
    "expo:start": "bun ./scripts/expo.js start --clear",
    "expo:start:tunnel": "bun ./scripts/expo.js start --clear --tunnel",
    "gh": "bun ./scripts/gh.js",
    "gh:secrets": "bun ./scripts/gh.js secret set DOT_ENV -f ./.env",
    "git": "bun ./scripts/git.js",
    "git:push": "bun ./scripts/git.js push origin HEAD",
    "github:deploy": "bun run github:secrets && bun run git:push",
    "github:remote": "bun ./scripts/git.js remote add origin",
    "github:workflow:expo": "bun ./scripts/gh.js workflow run deploy-expo.yml --ref main",
    "github:workflow:supabase": "bun ./scripts/gh.js workflow run deploy-supabase.yml --ref main",
    "opencode": "bun ./scripts/opencode.js",
    "skill": "bun ./scripts/skill.js",
    "supabase:initialize": "bun ./scripts/supabase.js init",
    "supabase:link": "bun ./scripts/supabase.js link",
    "supabase:migration": "bun ./scripts/supabase.js migration new",
    "supabase:push": "bun ./scripts/supabase.js db push --remote --include-seed --yes",
    "supabase:reset": "bun ./scripts/supabase.js db reset",
    "supabase:reset:remote": "bun ./scripts/supabase.js reset-remote",
    "supabase:start": "bun ./scripts/supabase.js start",
    "supabase:status": "bun ./scripts/supabase.js status",
    "supabase:stop": "bun ./scripts/supabase.js stop",
    "test": "bun ./scripts/bun.js test"
  },
  "allowScripts": {
    "@opencode/cli": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "babel-preset-expo": "~58.0.24",
    "expo": "^58.0.23",
    "expo-font": "~58.0.11",
    "expo-router": "~58.0.30",
    "expo-system-ui": "~58.0.7",
    "jsqr": "^1.4.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4",
    "react-qr-code": "^2.2.0",
    "tailwindcss": "^3.4.17",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@opencode/cli": "^2.4.1",
    "skills": "^1.9.0"
  },
  "trustedDependencies": [
    "@opencode/cli"
  ]
}
