{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CONTRIBUTING.md",
    "DESIGN.md"
  ],
  "mcp": {
    "servers": {
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cfeedback%2Cnotebooks"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        },
        "oauth": false
      },
      "penpot": {
        "type": "remote",
        "url": "https://design.penpot.app/mcp/stream?userToken={env:PENPOT_MCP_TOKEN}"
      },
      "expo": {
        "type": "remote",
        "url": "https://mcp.expo.dev/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "bun",
          "x",
          "--bun",
          "@playwright/mcp@latest",
          "--isolated",
          "--ignore-https-errors",
          "--output-dir",
          ".playwright"
        ]
      }
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  }
}
